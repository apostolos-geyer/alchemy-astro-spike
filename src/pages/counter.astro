---
// Uses Astro.session, which the adapter wires to the Cloudflare KV session
// driver against the "SESSION" binding. If that binding is not present on the
// deployed Worker, this must fail.
export const prerender = false;

import SplitFlap from "../components/SplitFlap.svelte";
import Terminal from "../layouts/Terminal.astro";

let value: number | undefined;
let error: string | undefined;

try {
  const current = (await Astro.session?.get<number>("count")) ?? 0;
  value = current + 1;
  await Astro.session?.set("count", value);
} catch (e) {
  error = e instanceof Error ? `${e.name}: ${e.message}` : String(e);
}

const display = String(value ?? 0).padStart(4, "0");
---

<Terminal title="Session counter — astro-ssr-spike" active="/counter">
  <section class="band band--flush">
    <div class="u-wrap head">
      <div class="u-stack">
        <p class="u-eyebrow">Gate /counter · session over KV</p>
        <h1 class="u-display u-display--md">Your visits,<br />held in KV</h1>
        <p class="u-lede">
          Astro's session API is bound to a KV namespace the stack declares as <code>SESSION</code>.
          A cookie identifies you, the value lives at the edge, and the number goes up once per load.
        </p>
        <a class="reload" href="/counter">Load again</a>
      </div>

      <div class="tally" data-error={error ?? "none"}>
        <p class="tally__key">Count</p>
        {
          error ? (
            <p class="tally__err">{error}</p>
          ) : (
            <SplitFlap client:load value={display} length={4} size="lg" animateOnMount={true} label={`count ${value}`} />
          )
        }
        <p class="tally__val" data-count={value ?? "none"}>
          {error ? "session unavailable" : `count: ${value}`}
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="u-wrap">
      <div class="band__head">
        <p class="u-eyebrow">Why it can fail</p>
        <h2 class="band__title">The binding is the whole story</h2>
        <p class="band__note">
          The adapter declares a <code>SESSION</code> binding in the wrangler config it emits, but Alchemy
          never reads that file. If the stack does not declare the namespace too, this page throws instead
          of counting.
        </p>
      </div>

      <div class="readout">
        <div class="readout__row">
          <span class="readout__key">count</span>
          <span class="readout__val">{value ?? "none"}</span>
        </div>
        <div class="readout__row">
          <span class="readout__key">error</span>
          <span class="readout__val">{error ?? "none"}</span>
        </div>
        <div class="readout__row">
          <span class="readout__key">driver</span>
          <span class="readout__val">cloudflare-kv-binding · SESSION</span>
        </div>
      </div>
    </div>
  </section>
</Terminal>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 54rem) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  .tally {
    background: linear-gradient(180deg, #1b232d 0%, #131a22 100%);
    border-radius: 5px;
    padding: 1.5rem;
    display: grid;
    justify-items: start;
    gap: 1rem;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 26px 50px -26px rgba(11, 16, 22, 0.75);
  }

  .tally__key,
  .tally__val,
  .tally__err {
    font-family: var(--mono);
    margin: 0;
  }

  .tally__key {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(233, 236, 240, 0.38);
  }

  .tally__val {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: rgba(240, 167, 25, 0.8);
  }

  .tally__err {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #e8836f;
    word-break: break-word;
  }

  .reload {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.5rem 0.8rem;
    transition: background 0.15s, border-color 0.15s;
  }

  .reload:hover {
    background: rgba(240, 167, 25, 0.16);
    border-color: rgba(165, 118, 15, 0.6);
  }

  code {
    font-family: var(--mono);
    font-size: 0.875em;
    background: rgba(21, 28, 36, 0.07);
    padding: 0.1em 0.3em;
    border-radius: 2px;
  }
</style>
