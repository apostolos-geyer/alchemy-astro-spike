---
// Prerendered at build time — must be served by the ASSETS layer, not the Worker.
export const prerender = true;
const builtAt = new Date().toISOString();

import EdgeBoard from "../components/EdgeBoard.svelte";
import Manifest from "../components/Manifest.svelte";
import { GATES, MANIFEST, SNAGS } from "../data/manifest";
import Terminal from "../layouts/Terminal.astro";

const verified = MANIFEST.filter((row) => row.status === "verified").length;

const APP_CONFIG = `// astro.config.mjs — the whole file
import svelte from "@astrojs/svelte";
import { defineConfig } from "astro/config";

export default defineConfig({
  integrations: [svelte()],
});`;

const STACK_CONFIG = `// infra/site.ts — everything Cloudflare-facing
export class Site extends Astro<Site>()("Site", {
  cache: { enabled: true },
  env: {
    SESSION: SessionKv,
    CACHE: Cache,
    UPLOADS: Uploads,
    API: ApiWorker,
  },
}) {}

export type SiteEnv = Cloudflare.InferEnv<typeof Site>;`;
---

<Terminal title="astro-ssr-spike — Astro SSR on Cloudflare Workers" active="/">
  <section class="hero">
    <div class="u-wrap hero__in">
      <div class="hero__copy">
        <p class="u-eyebrow">Spike · Astro 7.1.6 · Cloudflare Workers</p>
        <h1 class="u-display hero__title">One Astro app.<br />No Cloudflare<br />in its config.</h1>
        <p class="u-lede">
          Alchemy drives Astro through its Node API and layers the Cloudflare adapter on top — the
          same relationship it already has with Vite. {`${MANIFEST.length} capabilities on the manifest, ${verified} verified by live tests against real Cloudflare, five bugs found upstream along the way.`}
        </p>
        <ul class="chipset hero__chips">
          <li class="chip">route / · static page</li>
          <li class="chip">served from assets</li>
          <li class="chip" data-built-at={builtAt}>
            built {builtAt.slice(0, 10)} {builtAt.slice(11, 16)}Z
          </li>
        </ul>
      </div>

      <div class="hero__board">
        <EdgeBoard client:load live={true} mode="STATIC" />
        <p class="hero__caption">
          This page is a static file. The codes above are not — they came from a probe to <a
            href="/api/hello">/api/hello</a
          >, which reports the datacentre that answered it.
        </p>
      </div>
    </div>
  </section>

  <section class="band split">
    <div class="u-wrap">
      <div class="band__head">
        <p class="u-eyebrow">The split</p>
        <h2 class="band__title">The app knows nothing about the edge</h2>
        <p class="band__note">
          No adapter, no <code>output</code> mode, no <code>configPath</code> in the app. Bindings, cache
          and compatibility flags are declared once, in the stack, and the Worker <code>Env</code> type
          is derived from that declaration.
        </p>
      </div>

      <div class="split__grid">
        <figure class="slab">
          <figcaption class="slab__cap">app</figcaption>
          <pre class="slab__code">{APP_CONFIG}</pre>
        </figure>
        <figure class="slab">
          <figcaption class="slab__cap">stack</figcaption>
          <pre class="slab__code">{STACK_CONFIG}</pre>
        </figure>
      </div>

      <p class="split__warn">
        The load-bearing detail: Alchemy never reads the <code>wrangler.json</code> the adapter emits.
        Every line of that contract is mirrored explicitly by the resource. Miss one and it silently does
        not happen.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="u-wrap">
      <div class="band__head">
        <p class="u-eyebrow">Manifest</p>
        <h2 class="band__title">What the stack actually does</h2>
        <p class="band__note">
          Filter by status. Every route in this table is live — open one and check the claim
          yourself.
        </p>
      </div>
      <Manifest client:visible rows={MANIFEST} />
    </div>
  </section>

  <section class="band">
    <div class="u-wrap">
      <div class="band__head">
        <p class="u-eyebrow">Gates</p>
        <h2 class="band__title">Routes you can hit right now</h2>
        <p class="band__note">
          The two marked <code>workerd</code> import <code>cloudflare:workers</code>. That module
          only exists inside the Cloudflare runtime, so they answer when deployed or under Alchemy's
          dev server, and return 500 on a plain <code>astro dev</code>.
        </p>
      </div>

      <ul class="gates">
        {
          GATES.map((gate) => (
            <li class="gates__item">
              <a class="gates__link" href={gate.route}>
                <span class="gates__mode" data-mode={gate.mode}>
                  {gate.mode}
                </span>
                <span class="gates__label">{gate.label}</span>
                <span class="gates__route">{gate.route}</span>
                <span class="gates__note">{gate.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="u-wrap">
      <div class="band__head">
        <p class="u-eyebrow">Snag list</p>
        <h2 class="band__title">Found upstream while building this</h2>
        <p class="band__note">
          All five reproduced on latest <code>main</code>, none were duplicates. Four are filed with a
          patch attached.
        </p>
      </div>

      <ol class="snags">
        {
          SNAGS.map((snag) => (
            <li class="snags__item">
              <span class="snags__ref">{snag.ref === "—" ? "n/a" : `#${snag.ref}`}</span>
              <p class="snags__title">{snag.title}</p>
              <span class="snags__links">
                {snag.issue ? (
                  <a href={snag.issue}>issue</a>
                ) : (
                  <span class="snags__flag">{snag.prNote}</span>
                )}
                {snag.pr ? <a href={snag.pr}>patch{snag.prNote ? ` (${snag.prNote})` : ""}</a> : null}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Terminal>

<style>
  .hero {
    padding-block: clamp(2.75rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero__in {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero__title {
    font-size: clamp(2.1rem, 4.5vw, 3.5rem);
  }

  .hero__copy,
  .hero__board {
    min-width: 0;
  }

  .hero__chips {
    margin-top: 0.25rem;
  }

  .hero__board {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__caption {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--mist);
    max-width: 42ch;
  }

  .hero__caption a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  @media (max-width: 54rem) {
    .hero__in {
      grid-template-columns: 1fr;
    }
  }

  /* --- the split ---------------------------------------------------------- */

  .split__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
  }

  .slab {
    margin: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    background: var(--panel);
    overflow: hidden;
  }

  .slab__cap {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mist);
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--rule);
    background: rgba(21, 28, 36, 0.04);
  }

  .slab__code {
    margin: 0;
    padding: 1.1rem 1rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--ink-soft);
    overflow-x: auto;
  }

  .split__warn {
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--amber);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  code {
    font-family: var(--mono);
    font-size: 0.875em;
    background: rgba(21, 28, 36, 0.07);
    padding: 0.1em 0.3em;
    border-radius: 2px;
  }

  /* --- gates -------------------------------------------------------------- */

  .gates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }

  .gates__link {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: var(--panel);
    text-decoration: none;
    height: 100%;
    transition: background 0.15s;
  }

  .gates__link:hover {
    background: var(--hall-hi);
  }

  .gates__mode {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    justify-self: start;
    padding: 0.15rem 0.35rem;
    border-radius: 2px;
    color: var(--mist);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .gates__mode[data-mode="ssr"] {
    color: #a5760f;
    box-shadow: inset 0 0 0 1px rgba(165, 118, 15, 0.5);
  }

  .gates__mode[data-mode="static"] {
    color: var(--jade);
    box-shadow: inset 0 0 0 1px rgba(47, 125, 98, 0.45);
  }

  .gates__mode[data-mode="workerd"] {
    color: var(--flare);
    box-shadow: inset 0 0 0 1px rgba(200, 64, 44, 0.4);
  }

  .gates__label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 0.35rem;
  }

  .gates__route {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .gates__note {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--mist);
  }

  /* --- snags -------------------------------------------------------------- */

  .snags {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .snags__item {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 12rem;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .snags__ref {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mist);
  }

  .snags__title {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .snags__links {
    display: flex;
    gap: 0.85rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .snags__links a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .snags__links a:hover {
    color: #a5760f;
  }

  .snags__flag {
    color: var(--flare);
  }

  @media (max-width: 46rem) {
    .snags__item {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }

    .snags__links {
      grid-column: 2;
    }
  }
</style>
