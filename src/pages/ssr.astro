---
// Server-rendered on every request. If this were prerendered or cached, the
// nonce/timestamp would be identical across requests — that's the assertion.
export const prerender = false;

const nonce = crypto.randomUUID();
const renderedAt = new Date().toISOString();
const cfRay = Astro.request.headers.get("cf-ray") ?? "no-cf-ray";
// Astro v6 removed Astro.locals.runtime.cf — the request carries it now.
const colo = (Astro.request as any).cf?.colo ?? "no-colo";

// Workers Cache is enabled on this Worker, so a dynamic route must opt OUT
// explicitly or the edge serves a cached render and SSR silently stops.
Astro.response.headers.set("Cache-Control", "no-store");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro SSR spike — server</title>
  </head>
  <body>
    <h1>ssr page</h1>
    <p data-nonce={nonce}>nonce: {nonce}</p>
    <p data-rendered-at={renderedAt}>rendered at: {renderedAt}</p>
    <p data-cf-ray={cfRay}>cf-ray: {cfRay}</p>
    <p data-colo={colo}>colo: {colo}</p>
  </body>
</html>
