---
import { FLEET } from "../data/manifest";
import "../styles/terminal.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "Astro SSR on Cloudflare Workers, deployed by Alchemy. A spike, with its evidence attached.",
  active = "",
} = Astro.props;

const NAV = [
  { href: "/", label: "Home" },
  { href: "/ssr", label: "SSR" },
  { href: "/counter", label: "Session" },
  { href: "/ssr-content", label: "Content" },
  { href: "/blog", label: "Blog" },
  { href: "/cached", label: "Cache" },
];

const REPO = "https://github.com/apostolos-geyer/alchemy-astro-spike";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400..700&display=swap"
    />
  </head>

  <body>
    <header class="chrome">
      <div class="u-wrap chrome__in">
        <a class="chrome__mark" href="/">astro-ssr-spike</a>
        <nav class="chrome__nav" aria-label="Routes">
          {
            NAV.map((item) => (
              <a
                class="chrome__link"
                href={item.href}
                aria-current={active === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="chrome__src" href={REPO} rel="noreferrer">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          <span>Source</span>
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="ground">
      <div class="u-wrap">
        <p class="u-eyebrow" style="margin-bottom: 1.5rem">Fleet</p>
        <div class="ground__grid">
          {
            FLEET.map((item) => (
              <div class="ground__cell">
                <span class="ground__key">{item.key}</span>
                <span class="ground__val">{item.value}</span>
              </div>
            ))
          }
        </div>
        <p class="ground__note">
          <strong>Written by Claude Code, barely reviewed by a human.</strong> The claims are backed
          by tests that ran against real Cloudflare; the code quality, API design and naming are not.
          Read <code>ASTRO.md</code> for the adapter-to-Alchemy mapping, the dev-mode limits, and every
          footgun with the error string it produces.
        </p>
        <p class="ground__note">
          Source, tests and write-up: <a class="ground__link" href={REPO} rel="noreferrer"
            >github.com/apostolos-geyer/alchemy-astro-spike</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
